# Credenciales de MongoDB. Copiar a `.env` en la RAIZ de este repo:
#
#   Copy-Item mongodb/.env-example .env
#
# El stack NO arranca sin estas dos variables: no hay defaults. Si se dejan
# placeholders, cambialos por valores reales antes del primer `docker compose up`,
# porque el ejemplo es publico en el repo.
MONGODB_ROOT_USERNAME=REEMPLAZAR_POR_USUARIO_REAL
MONGODB_ROOT_PASSWORD=REEMPLAZAR_POR_PASSWORD_FUERTE
